{
  "name": "riscv-sim-backend",
  "version": "1.0.0",
  "description": "HTTP API that assembles and runs RISC-V programs on the C++ simulator and returns structured JSON timelines",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build:simulator": "cmake -S .. -B ../build -DCMAKE_BUILD_TYPE=Release && cmake --build ../build --target rvsim rvasm",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1"
  }
}
